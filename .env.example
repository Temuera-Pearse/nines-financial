NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://localhost:5432/nines_financial

# API -> Financial. The primary key is required when ingestion is enabled.
# Additional keys are receiver-side overlap for rotation. Production callers
# must reach this service over HTTPS at the deployment edge.
NINES_API_FUNDING_ATTESTATIONS_ENABLED=false
NINES_API_PLAYER_GAMEPLAY_ENABLED=false
NINES_LEGACY_DEPOSIT_PROVIDER_ENABLED=true
# NINES_API_AUTH_KEY_ID=api-financial-v2
# NINES_API_AUTH_HMAC_SECRET=replace-with-api-to-financial-secret-at-least-32-characters
# NINES_API_AUTH_HMAC_ADDITIONAL_KEYS={"api-financial-v1":"replace-with-previous-api-to-financial-secret-at-least-32-characters"}
NINES_SERVICE_AUTH_REPLAY_WINDOW_SECONDS=300

# Backend -> Financial authenticated NINES wager intake. Transport nonces are
# fresh per HTTP attempt; the economic idempotency key remains unchanged.
NINES_BACKEND_WAGER_INTAKE_ENABLED=false
NINES_BACKEND_RACE_LIFECYCLE_ENABLED=false
NINES_BACKEND_RACE_RESULT_ENABLED=false
NINES_RACE_RESULT_RECOVERY_ENABLED=true
NINES_RACE_RESULT_RECOVERY_POLL_INTERVAL_MS=1000
NINES_RACE_RESULT_RECOVERY_LEASE_MS=30000
NINES_RACE_RESULT_RECOVERY_MAX_ATTEMPTS=12
NINES_RACE_RESULT_RECOVERY_BATCH_SIZE=25
# NINES_BACKEND_AUTH_KEY_ID=backend-wager-v1
# NINES_BACKEND_AUTH_HMAC_SECRET=replace-with-backend-to-financial-secret-at-least-32-characters
# NINES_BACKEND_AUTH_HMAC_ADDITIONAL_KEYS={"backend-wager-v0":"replace-with-previous-backend-to-financial-secret-at-least-32-characters"}

# Financial -> Security. Use a secret different from API -> Financial and from
# API -> Security. Production Security URLs must use HTTPS.
NINES_SECURITY_EVIDENCE_DELIVERY_ENABLED=false
# NINES_SECURITY_SERVICE_BASE_URL=https://nines-security.example
# NINES_SECURITY_AUTH_KEY_ID=financial-security-v1
# NINES_SECURITY_AUTH_HMAC_SECRET=replace-with-financial-to-security-secret-at-least-32-characters
NINES_SERVICE_DELIVERY_POLL_INTERVAL_MS=1000

# Development/test compatibility only; never a production fallback.
NINES_SERVICE_AUTH_MODE=hmac
# NINES_SERVICE_AUTH_KEY_ID=development-hmac-v1
# NINES_SERVICE_AUTH_HMAC_SECRET=replace-with-nonproduction-shared-secret-at-least-32-characters
