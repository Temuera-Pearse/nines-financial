{
  "name": "nines-financial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 2.5 financial authority service for the Nines betting platform",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:real-postgres": "vitest run tests/integration/realPostgresProductionDrills.test.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
